# Yallah Services — Job Radar : variables d'environnement.
# Copiez ce fichier en « .env » pour un déploiement. `npm run local` n'en a pas besoin :
# il crée sa base et sa clé dans .data/.

# --- Obligatoire en dehors de `npm run local` --------------------------------
# PostgreSQL 17 (version utilisée par les tests et par la base embarquée).
DATABASE_URL=postgres://utilisateur:mot-de-passe@hote:5432/yallah_job_radar

# Clé maîtresse (32 octets au moins, base64 ou hexadécimal). Elle chiffre les données
# personnelles : la perdre les rend illisibles, la changer aussi. À sauvegarder à part.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
YS_CLE_SECRETE=

# --- Premier compte administrateur (npm run db:initialiser) -------------------
YS_ADMIN_EMAIL=
# YS_ADMIN_NOM=Administrateur
# Facultatif : sinon un mot de passe provisoire est généré et affiché une seule fois.
# YS_ADMIN_MOT_DE_PASSE=

# --- Application --------------------------------------------------------------
# PORT=3000
# Adresse publique de l'outil (liens dans les e-mails d'alerte).
# YS_URL_PUBLIQUE=https://radar.exemple.ma
# Durée d'une session, en heures (1 à 72 ; 12 par défaut).
# YS_SESSION_HEURES=12
# Force le cookie de session en « Secure ». Inutile si YS_URL_PUBLIQUE est en https ou si le proxy
# transmet « X-Forwarded-Proto: https ».
# YS_COOKIE_SECURISE=1
# Taille du pool de connexions PostgreSQL.
# YS_DB_POOL_MAX=8

# --- Collecte -----------------------------------------------------------------
# User-Agent des requêtes de collecte : identifiable, avec un contact.
# YS_COLLECTE_USER_AGENT=YallahJobRadar/0.1 (+mailto:contact@exemple.ma)

# --- Facultatif : envois d'alertes --------------------------------------------
# Sans ces valeurs, les envois sont enregistrés avec le statut « simulé » et ne partent pas.
# YS_EMAIL_API_URL=
# YS_EMAIL_API_CLE=
# YS_EMAIL_EXPEDITEUR=
# YS_WHATSAPP_API_URL=
# YS_WHATSAPP_API_CLE=

# --- Facultatif : complément d'extraction par IA ------------------------------
# API compatible « chat completions ». Sans ces trois valeurs, aucune annonce n'est envoyée
# à un modèle. Même configuré, il n'est utilisé que pour les sources qui l'autorisent.
# YS_IA_API_URL=
# YS_IA_API_CLE=
# YS_IA_MODELE=

# --- Environnements de prévisualisation uniquement ---------------------------
# Autorise l'affichage dans une iframe (cookie SameSite=None). JAMAIS en production.
# YS_APERCU_INTEGRE=1
# Hôtes supplémentaires acceptés pour les formulaires (ex. « *.exemple.dev »).
# YS_ORIGINES_AUTORISEES=

# --- Développement ------------------------------------------------------------
# Emplacement et port de la base embarquée de `npm run local`.
# YS_DONNEES_DOSSIER=.data
# YS_PG_PORT=54329
# Base utilisée par les tests d'intégration (sinon une base embarquée temporaire).
# YS_TEST_DATABASE_URL=
